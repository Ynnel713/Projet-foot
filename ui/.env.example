# Copier en ui/.env.local (ignoré par git, règle *.local de ui/.gitignore) pour surcharger la valeur sur CE poste ; sans ce
# fichier, `npm run dev` utilise déjà cette valeur par défaut (voir ui/src/api/client.js).
#
# URL de l'API FastAPI appelée par la PWA en développement séparé (`npm run dev`, frontend sur le port 5173).
# 8000 est le port utilisé par simulafoot.bat (uvicorn api.main:app --port 8000) ET par le build servi par l'API elle-même
# (ui/dist, même origine, voir api/main.py). Ne changer que pour pointer vers une autre API (ex. http://192.168.1.4:8000
# depuis un téléphone sur le réseau local).
VITE_API_URL=http://localhost:8000
