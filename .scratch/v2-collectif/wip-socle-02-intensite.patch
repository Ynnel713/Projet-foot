@@ -0,0 +1,96 @@
+"""Tests du moteur V2, ticket v2-socle/02 (intensité de course : fin du sprint permanent). Voir
+.scratch/v2-socle/issues/02-intensite-de-course.md."""
+
+from __future__ import annotations
+
+import math
+
+from v2engine.ball_state import BallState
+from v2engine.geometry import PITCH_LENGTH_M, PITCH_WIDTH_M, Vec2
+from v2engine.match import (
+    ARRIVAL_RADIUS_M,
+    BLOCK_SHIFT,
+    PRESS_BURST_S,
+    PRESS_INTENSITY,
+    WALK_MPS,
+    _step_off_ball,
+    _step_player,
+)
+from v2engine.movement import PlayerState, intensity, max_speed_mps, step
+
+CENTER = Vec2(PITCH_LENGTH_M / 2.0, PITCH_WIDTH_M / 2.0)
+
+
+def _player(name: str = "P", team: str = "home", poste: str = "MC", position: Vec2 = CENTER, pace: float = 60,
+            stamina: float = 60, attributes: dict[str, int] | None = None, fatigue_minute: float | None = None) -> PlayerState:
+    return PlayerState(
+        name=name, team=team, poste=poste, position=position, velocity=Vec2(0.0, 0.0),
+        pace=pace, acceleration=60, stamina=stamina, home_target=position, attributes=attributes,
+        fatigue_minute=fatigue_minute,
+    )
+
+
+def test_work_rate_sets_pressing_intensity_at_validated_points() -> None:
+    for note, expected in ((11, 0.55), (55, 0.8), (99, 1.0)):
+        assert math.isclose(intensity(note, PRESS_INTENSITY), expected)
+
+
+def test_pace_only_sets_top_speed_near_his_place() -> None:
+    # à l'approche de sa place, rapide ou lent marchent au même pas : Pace n'est que la vitesse max
+    def walk_speed(pace: float) -> float:
+        p = _player(pace=pace, position=CENTER + Vec2(ARRIVAL_RADIUS_M / 2.0, 0.0))
+        for _ in range(20):
+            p = _step_off_ball(p, 0.1, CENTER, 10.0, 1.0)
+        return p.velocity.length()
+    assert math.isclose(walk_speed(20), walk_speed(95), rel_tol=0.05)
+    assert walk_speed(95) <= WALK_MPS + 1e-9
+
+
+def test_effort_advances_fatigue_faster_than_walking() -> None:
+    target = CENTER + Vec2(500.0, 0.0)
+    sprinter = _player(fatigue_minute=0.0)
+    walker = _player(fatigue_minute=0.0)
+    for _ in range(600):  # 60 s
+        sprinter = step(sprinter, 0.1, target, 1.0, 1.0)
+        walker = step(walker, 0.1, target, 1.0, 0.2)
+    assert sprinter.fatigue_minute > 3.0 * walker.fatigue_minute
+
+
+def test_high_work_rate_low_stamina_fades_before_high_stamina() -> None:
+    # même effort (même minute de fatigue), Stamina basse : vitesse max plus basse en fin de match
+    def top_speed(stamina: float) -> float:
+        p = _player(stamina=stamina, fatigue_minute=80.0)
+        for _ in range(40):
+            p = step(p, 0.1, CENTER + Vec2(500.0, 0.0), 80.0, 1.0)
+        return p.velocity.length()
+    assert top_speed(20) < top_speed(90) <= max_speed_mps(60)
+
+
+def test_block_slides_with_the_ball() -> None:
+    p = _player(position=CENTER)
+    ball = BallState(position=CENTER + Vec2(20.0, 10.0), velocity=Vec2(0.0, 0.0), holder="X")
+    holder = _player("X", team="away", position=ball.position)
+    other = _player("Proche", team="home", position=ball.position + Vec2(1.0, 0.0))  # presse à sa place
+    moved = _step_player(p, ball, 0.1, 10.0, [p, holder, other])
+    shifted = CENTER + Vec2(20.0 * BLOCK_SHIFT[0], 10.0 * BLOCK_SHIFT[1])
+    assert moved.velocity.x > 0.0 and moved.velocity.y > 0.0  # il part vers sa place décalée
+    assert moved.position.distance_to(shifted) < CENTER.distance_to(shifted)
+
+
+def test_presser_rests_after_his_burst_and_the_next_one_takes_over() -> None:
+    holder = _player("Porteur", team="away", position=CENTER)
+    first = _player("Premier", position=CENTER + Vec2(4.0, 0.0), attributes={"Work Rate": 55})
+    second = _player("Second", position=CENTER + Vec2(8.0, 0.0), attributes={"Work Rate": 55})
+    ball = BallState(position=CENTER, velocity=Vec2(0.0, 0.0), holder="Porteur")
+    pressing: dict[str, tuple[float | None, float]] = {}
+    players = [holder, first, second]
+
+    def tick(now_s: float) -> None:
+        for p in (first, second):
+            _step_player(p, ball, 0.1, now_s / 60.0, players, None, pressing)
+    tick(0.0)
+    assert pressing["Premier"][0] == 0.0 and pressing["Second"][0] is None  # un seul presseur
+    tick(PRESS_BURST_S)
+    assert pressing["Premier"][1] > PRESS_BURST_S  # il souffle
+    tick(PRESS_BURST_S + 0.1)
+    assert pressing["Second"][0] is not None  # le suivant prend le relais
