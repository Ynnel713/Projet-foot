+def screen_player(players: list[PlayerState], team: str) -> PlayerState | None:
+    """Milieu qui fait l'écran devant la défense (ticket v2-realisme/10d) : parmi les MDC et MC de `team` hors mezzala, box
+    to box et meneur, le premier selon le rôle (`SCREEN_ROLE_ORDER`), puis le plus près de son but au départ, puis le plus
+    près de l'axe ; à égalité, l'ordre de la composition. Aucun candidat : pas d'écran."""
+    candidates = [p for p in players if p.team == team and p.poste in SCREEN_POSTES
+                  and p.role not in SCREEN_EXCLUDED_ROLES]
+    if not candidates:
+        return None
+    rank = {role: i for i, role in enumerate(SCREEN_ROLE_ORDER)}
+    return min(candidates, key=lambda p: (rank.get(p.role, len(rank)), round(_progress(team, p.home_target.x), 6),
+                                          round(abs(p.home_target.y - _CENTER.y), 6)))
+
+
+def screen_place(team: str, ball: Vec2, line_x: float) -> Vec2 | None:
+    """Place d'écran (ticket 10d) : sur la ligne ballon-centre de son but, `SCREEN_GAP_M` devant la dernière ligne
+    (`line_x`, abscisse). None si le ballon est déjà plus près du but que ce point (défense de la surface, ticket 10f)."""
+    height = _progress(team, line_x) + SCREEN_GAP_M
+    ball_depth = _progress(team, ball.x)
+    if ball_depth <= height:
+        return None
+    goal = Vec2(0.0 if team == "home" else PITCH_LENGTH_M, _CENTER.y)
+    return goal + (ball - goal) * (height / ball_depth)
+
+
+def screen_weight(ball: Vec2) -> float:
+    """Part de la place d'écran (ticket 10d) : 0 ballon à `SCREEN_SIDE_M[0]` de l'axe ou moins, 1 à `SCREEN_SIDE_M[1]` ou
+    plus, linéaire entre les deux."""
+    low, high = SCREEN_SIDE_M
+    return min(max((abs(ball.y - _CENTER.y) - low) / (high - low), 0.0), 1.0)
+
