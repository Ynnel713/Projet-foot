+PREWARM_LIMIT = 1
+"""Nombre de matchs préchauffés par journée simulée. Revue QC du 23/10/2026 (`animation-prechauffage-cache`,
+1er passage REFUSÉ) : préchauffer toute la journée tourne dans le même process `uvicorn` mono-worker que les
+requêtes réelles (`simulafoot.bat`, pas de `--workers`), donc contend sous le même GIL avec quiconque ouvre une
+animation pendant la boucle -- jusqu'à 90-140 s de calcul séquentiel pour ~10 matchs Ligue 1, sans aucune priorité
+sur le match réellement regardé. Borné à 1 (le premier match de la journée, le plus probable d'être regardé en
+premier -- ordre d'affichage de `MatchRow`) : le pire cas de contention ajoutée reste un seul calcul à froid
+(8,7-10,6 s documentés, `docs/ticket4_latency_audit.md`), du même ordre qu'une requête d'animation normale déjà
+acceptée aujourd'hui, au lieu de le multiplier par le nombre de matchs de la journée."""
+
+
+def _prewarm_animations(matches: list[Match], label: str) -> None:
+    """Remplit le cache LRU de `build_match_animation_json` juste après simulation, en tâche de fond (après l'envoi
+    de la réponse HTTP) -- pour qu'un clic ultérieur sur "Voir l'animation"/"LIVE" tombe déjà en cache au lieu de
+    recalculer à froid (ticket 4, docs/known_issues.md ; latence à froid mesurée, non résolue par le cache seul :
+    voir docs/ticket4_latency_audit.md). Borné à `PREWARM_LIMIT` matchs par l'appelant (voir sa docstring) --
+    cette fonction ne tronque pas elle-même la liste reçue, pour rester testable indépendamment de la limite.
+    Best-effort : une erreur sur un match ne doit jamais faire échouer les autres ni remonter au client, qui a
+    déjà reçu sa réponse."""
+    for match in matches:
+        try:
+            build_match_animation_json(match, label)
+        except Exception:
+            _logger.exception("Préchauffage de l'animation échoué pour %s - %s (%s)", match.home, match.away, label)
+
+
