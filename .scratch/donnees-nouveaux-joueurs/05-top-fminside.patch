+class TopAPI(FakeAPI):
+    """Faux client du mode top : liste du site dans l'ordre, postes naturels pris de la recherche."""
+
+    def __init__(self, rows, bad_profiles=()):
+        super().__init__({}, bad_profiles)
+        self.rows = rows
+        self.asked = None
+
+    def top(self, n):
