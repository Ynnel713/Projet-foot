+def test_prewarm_animations_is_best_effort_one_failure_does_not_stop_the_rest(played_competition, monkeypatch):
+    _, competition, _ = played_competition
+    animation_module.clear_cache()
+    good_match, reference = _first_animable(competition)
+    bad_match = next(m for m in competition.season.calendar[0].matches if m is not good_match)
+
+    real = animation_module.build_match_animation_json
+
+    def flaky(match, label):
+        if match is bad_match:
+            raise RuntimeError("boom")
+        return real(match, label)
+
+    monkeypatch.setattr("api.routers.competitions.build_match_animation_json", flaky)
+
+    _prewarm_animations([bad_match, good_match], "j1")  # ne lève jamais, malgré l'échec sur bad_match
+
+    monkeypatch.undo()
+    assert json.loads(build_match_animation_json(good_match, "j1")) == reference
+
+
+def test_simulate_current_schedules_prewarm_with_the_matching_label(monkeypatch):
+    """Vérifie le câblage (ticket "raccourcir le chargement de l'animation") : la tâche de fond planifiée par
+    `simulate_current` porte exactement le libellé que `get_match_animation`/`_locate_match` utiliseront ensuite
+    pour cette journée -- sinon le préchauffage remplirait le cache sous la mauvaise clé -- et reste bornée à
+    `PREWARM_LIMIT` match(s) (revue QC du 23/10/2026 : toute la journée contend avec les requêtes réelles dans le
+    même process mono-worker, voir la docstring de `PREWARM_LIMIT`)."""
+    clubs = load_clubs(CLUBS_PATH, "Ligue 1")
+    competition = CustomCompetition(format="LEAGUE", legs=2, clubs=clubs, label="Ligue 1")
+    comp_id = store.create(competition)
+
+    scheduled = []
+    monkeypatch.setattr(
+        "api.routers.competitions._prewarm_animations",
+        lambda matches, label: scheduled.append((list(matches), label)),
+    )
+
+    bg = BackgroundTasks()
+    simulate_current(comp_id, bg)
+    for task in bg.tasks:
+        task.func(*task.args, **task.kwargs)
+
+    assert len(scheduled) == 1
+    matches, label = scheduled[0]
+    assert label == "j1"
+    assert matches == competition.season.calendar[0].matches[:PREWARM_LIMIT]
+    assert len(matches) == PREWARM_LIMIT
+
+
+def test_simulate_all_schedules_prewarm_for_the_last_journee_only(monkeypatch):
+    """Même garantie que `test_simulate_current_schedules_prewarm_with_the_matching_label`, pour `simulate_all` --
+    revue QC du 23/10/2026 (2e passage REFUSÉ) : ce call site applique la même troncature `PREWARM_LIMIT` mais
+    n'avait aucun test dédié, alors que c'est la route du bouton "Simuler tout" de l'écran Simulation. Vérifie en
+    particulier que seule la DERNIÈRE journée (celle affichée ensuite, pas toute la saison) est programmée."""
+    clubs = load_clubs(CLUBS_PATH, "Ligue 1")
+    competition = CustomCompetition(format="LEAGUE", legs=2, clubs=clubs, label="Ligue 1")
+    comp_id = store.create(competition)
+    total_journees = competition.season.total_journees
+
+    scheduled = []
+    monkeypatch.setattr(
+        "api.routers.competitions._prewarm_animations",
+        lambda matches, label: scheduled.append((list(matches), label)),
+    )
+
+    bg = BackgroundTasks()
+    simulate_all(comp_id, bg)
+    for task in bg.tasks:
+        task.func(*task.args, **task.kwargs)
+
+    assert len(scheduled) == 1  # une seule tâche programmée, pas une par journée de la saison
+    matches, label = scheduled[0]
+    assert label == f"j{total_journees}"
+    assert matches == competition.season.calendar[total_journees - 1].matches[:PREWARM_LIMIT]
+    assert len(matches) == PREWARM_LIMIT
+
