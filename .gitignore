# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# Backups ponctuels du classeur joueurs (data/joueurs.xlsx est déjà suivi par
# git, qui sert lui-même d'historique -- pas besoin de garder ces copies).
# Motif corrigé le 26/09/2026 : l'ancien "data/*.backup*.xlsx" ne matchait pas
# la vraie convention de nommage ("joueurs_backup_AAAAMMJJ_HHMMSS.xlsx" /
# "joueurs_avant_*.xlsx"), ces fichiers restaient donc non ignorés (git status
# les listait en "??") depuis le début de l'enrichissement FM26.
data/*_backup_*.xlsx
data/*_avant_*.xlsx

# Données de scraping FM26 (voir scripts/scrape_fminside_attributes.py) :
# reproductibles depuis data/joueurs.xlsx (suivi par git) + le site, pas du
# code, pas la source de vérité.
data/.fminside_cache.json
data/fminside_matching_report.csv

# Photos de joueurs (voir scripts/extract_faces.py) : régénérables à tout
# moment depuis le megapack Sortitoutsi (~16 Go, jamais versionné) +
# data/joueurs.xlsx -- des centaines/milliers de PNG, aucun intérêt à les
# faire gonfler l'historique git.
assets/faces/

# Images générées par scripts/preview_templates.py (audit visuel, pas du code)
scripts/output/

# HTML généré par scripts/render_preview.py / scripts/render_player_preview.py
# (canvas.html + JSON injecté, artefact de build, pas du code --
# render/canvas.html lui-même reste suivi)
render/canvas_preview.html
render/canvas_player_preview.html
